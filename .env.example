PORT=4000
HOST=0.0.0.0
NODE_ENV=development
TRUST_PROXY=false
SERVE_STATIC_CLIENT=false

PUBLIC_APP_URL=
CLIENT_ORIGINS=http://localhost:5173
VITE_API_BASE_URL=/api
VITE_SOCKET_URL=
VITE_DEV_API_TARGET=http://127.0.0.1:4000

AUTH_SECRET=replace-with-a-long-random-secret
AUTH_TOKEN_TTL=7d
AUTH_ISSUER=eventpulse-api
AUTH_AUDIENCE=eventpulse-client

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password
ADMIN_PASSWORD_HASH=
ADMIN_AUTH_SECRET=replace-with-a-separate-long-random-secret
ADMIN_AUTH_TOKEN_TTL=12h
ADMIN_NAME=EventPulse Admin

TIDB_HOST=your-tidb-host
TIDB_PORT=4000
TIDB_USER=your-tidb-user
TIDB_PASSWORD=your-tidb-password
TIDB_DB_NAME=eventpulse
TIDB_ENABLE_SSL=true
TIDB_CA_PATH=
TIDB_CA_CERT=
DB_CREATE_IF_MISSING=true
DB_CONNECTION_LIMIT=10
DB_QUEUE_LIMIT=0
DB_CONNECT_TIMEOUT_MS=10000
SEED_SAMPLE_EVENTS=true

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password
MAIL_FROM=EventPulse <noreply@example.com>
LOG_EMAIL_TRANSACTIONS=false

FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"your-firebase-project-id","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"firebase-adminsdk@example.iam.gserviceaccount.com","client_id":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token","auth_provider_x509_cert_url":"https://www.googleapis.com/oauth2/v1/certs","client_x509_cert_url":"https://www.googleapis.com/robot/v1/metadata/x509/firebase-adminsdk@example.iam.gserviceaccount.com","universe_domain":"googleapis.com"}
FIREBASE_SERVICE_ACCOUNT_BASE64=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

VITE_FIREBASE_API_KEY=your-firebase-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-firebase-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-firebase-project-id
VITE_FIREBASE_APP_ID=your-firebase-web-app-id
VITE_FIREBASE_STORAGE_BUCKET=your-firebase-project-id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your-firebase-sender-id
