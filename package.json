{
  "name": "eventpulse",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "engines": {
    "node": ">=20 <25"
  },
  "scripts": {
    "dev": "vite",
    "dev:client": "vite",
    "dev:server": "node --watch server/index.js",
    "dev:full": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "build": "vite build",
    "db:bootstrap": "node server/scripts/bootstrapDatabase.js",
    "db:check": "node test-db.js",
    "preview": "vite preview",
    "start": "node server/index.js",
    "test": "cross-env NODE_ENV=test vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.1",
    "express-rate-limit": "^8.5.2",
    "google-auth-library": "^10.6.2",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "leaflet": "^1.9.4",
    "mysql2": "^3.11.5",
    "nodemailer": "^6.10.1",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "recharts": "^3.8.1",
    "sequelize": "^6.37.8",
    "socket": "^1.1.76",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.3",
    "concurrently": "^9.1.2",
    "cross-env": "^10.1.0",
    "supertest": "^7.2.2",
    "vite": "^5.4.10",
    "vitest": "^4.1.5"
  }
}
